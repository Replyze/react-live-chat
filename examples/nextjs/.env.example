# Copy to .env.local.

# The widget token: Settings → Integrations → Install widget. Not a secret.
NEXT_PUBLIC_REPLYZE_TOKEN=wgt_YOUR_TOKEN

# Optional. The identity verification secret: Settings → Chat Widget → Identity.
# A secret: server-side only, never NEXT_PUBLIC_. Without it, users are identified unverified.
REPLYZE_IDENTITY_SECRET=
